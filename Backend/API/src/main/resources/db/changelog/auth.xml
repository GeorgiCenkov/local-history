<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1777279405580-3" author="gabig">
        <createSequence incrementBy="50" sequenceName="token_seq" startValue="1"/>
    </changeSet>
    <changeSet id="1777279405580-4" author="gabig">
        <createTable tableName="token">
            <column name="id" type="INT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_token"/>
            </column>
            <column name="refresh_token" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="expiration_date" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="is_revoked" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="revoked_at" type="DATETIME"/>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1777279405580-5" author="gabig">
        <addColumn tableName="user">
            <column name="user_type" type="VARCHAR(31)"/>
        </addColumn>
    </changeSet>
    <changeSet id="1777279405580-6" author="gabig">
        <update tableName="user">
            <column name="user_type" value="User"/>
            <where>user_type is null</where>
        </update>
    </changeSet>
    <changeSet id="1777279405580-7" author="gabig">
        <addNotNullConstraint columnName="user_type" tableName="user"/>
    </changeSet>
    <changeSet id="1777279405580-8" author="gabig">
        <addForeignKeyConstraint baseColumnNames="user_id" baseTableName="token" constraintName="FK_TOKEN_ON_USER"
                                 referencedColumnNames="id" referencedTableName="user"/>
    </changeSet>
    <changeSet id="1777279405580-1" author="gabig">
        <dropColumn columnName="birth_date" tableName="user"/>
    </changeSet>
    <changeSet id="1777279405580-2" author="gabig">
        <addColumn tableName="user">
            <column name="birth_date" type="DATE">
                <constraints nullable="false" validateNullable="true"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>