<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1777312794693-1" author="gabig">
        <createSequence incrementBy="50" sequenceName="landmark_visits_seq" startValue="1"/>
    </changeSet>
    <changeSet id="1777312794693-2" author="gabig">
        <createSequence incrementBy="50" sequenceName="landmarks_seq" startValue="1"/>
    </changeSet>
    <changeSet id="1777312794693-3" author="gabig">
        <createSequence incrementBy="50" sequenceName="quiz_questions_seq" startValue="1"/>
    </changeSet>
    <changeSet id="1777312794693-4" author="gabig">
        <createSequence incrementBy="50" sequenceName="quizzes_seq" startValue="1"/>
    </changeSet>
    <changeSet id="1777312794693-5" author="gabig">
        <createSequence incrementBy="50" sequenceName="tokens_seq" startValue="1"/>
    </changeSet>
    <changeSet id="1777312794693-6" author="gabig">
        <createSequence incrementBy="50" sequenceName="users_seq" startValue="1"/>
    </changeSet>
    <changeSet id="1777312794693-7" author="gabig">
        <createTable tableName="landmark_visits">
            <column name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_landmark_visits"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="landmark_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="date_visited" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="image" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="latitude" type="DOUBLE">
                <constraints nullable="false"/>
            </column>
            <column name="longitude" type="DOUBLE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1777312794693-8" author="gabig">
        <createTable tableName="landmarks">
            <column name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_landmarks"/>
            </column>
            <column name="title" type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="date_created" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="image_url" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="visit_reward_points" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="latitude" type="DOUBLE">
                <constraints nullable="false"/>
            </column>
            <column name="longitude" type="DOUBLE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1777312794693-9" author="gabig">
        <createTable tableName="quiz_question_options">
            <column name="question_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="option_text" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
    <changeSet id="1777312794693-10" author="gabig">
        <createTable tableName="quiz_questions">
            <column name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_quiz_questions"/>
            </column>
            <column name="question" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="correct_answer" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="quiz_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1777312794693-11" author="gabig">
        <createTable tableName="quizzes">
            <column name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_quizzes"/>
            </column>
            <column name="title" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="landmark_id" type="BIGINT"/>
        </createTable>
    </changeSet>
    <changeSet id="1777312794693-12" author="gabig">
        <createTable tableName="tokens">
            <column name="id" type="INT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_tokens"/>
            </column>
            <column name="refresh_token" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="expiration_date" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="is_revoked" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="revoked_at" type="DATETIME"/>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1777312794693-13" author="gabig">
        <createTable tableName="users">
            <column name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_users"/>
            </column>
            <column name="user_type" type="VARCHAR(31)">
                <constraints nullable="false"/>
            </column>
            <column name="first_name" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="last_name" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="password_hash" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="birth_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="level" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="points" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="points_required" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1777312794693-14" author="gabig">
        <addUniqueConstraint columnNames="landmark_id" constraintName="uc_quizzes_landmark" tableName="quizzes"/>
    </changeSet>
    <changeSet id="1777312794693-15" author="gabig">
        <addUniqueConstraint columnNames="email" constraintName="uc_users_email" tableName="users"/>
    </changeSet>
    <changeSet id="1777312794693-16" author="gabig">
        <addForeignKeyConstraint baseColumnNames="landmark_id" baseTableName="landmark_visits"
                                 constraintName="FK_LANDMARK_VISITS_ON_LANDMARK" referencedColumnNames="id"
                                 referencedTableName="landmarks"/>
    </changeSet>
    <changeSet id="1777312794693-17" author="gabig">
        <addForeignKeyConstraint baseColumnNames="user_id" baseTableName="landmark_visits"
                                 constraintName="FK_LANDMARK_VISITS_ON_USER" referencedColumnNames="id"
                                 referencedTableName="users"/>
    </changeSet>
    <changeSet id="1777312794693-18" author="gabig">
        <addForeignKeyConstraint baseColumnNames="landmark_id" baseTableName="quizzes"
                                 constraintName="FK_QUIZZES_ON_LANDMARK" referencedColumnNames="id"
                                 referencedTableName="landmarks"/>
    </changeSet>
    <changeSet id="1777312794693-19" author="gabig">
        <addForeignKeyConstraint baseColumnNames="quiz_id" baseTableName="quiz_questions"
                                 constraintName="FK_QUIZ_QUESTIONS_ON_QUIZ" referencedColumnNames="id"
                                 referencedTableName="quizzes"/>
    </changeSet>
    <changeSet id="1777312794693-20" author="gabig">
        <addForeignKeyConstraint baseColumnNames="user_id" baseTableName="tokens" constraintName="FK_TOKENS_ON_USER"
                                 referencedColumnNames="id" referencedTableName="users"/>
    </changeSet>
    <changeSet id="1777312794693-21" author="gabig">
        <addForeignKeyConstraint baseColumnNames="question_id" baseTableName="quiz_question_options"
                                 constraintName="fk_quiz_question_options_on_quiz_question" referencedColumnNames="id"
                                 referencedTableName="quiz_questions"/>
    </changeSet>
    <changeSet id="1777312794693-22" author="gabig">
        <dropSequence sequenceName="landmark_seq"/>
    </changeSet>
    <changeSet id="1777312794693-23" author="gabig">
        <dropSequence sequenceName="landmark_visit_seq"/>
    </changeSet>
    <changeSet id="1777312794693-24" author="gabig">
        <dropSequence sequenceName="quiz_question_seq"/>
    </changeSet>
    <changeSet id="1777312794693-25" author="gabig">
        <dropSequence sequenceName="quiz_seq"/>
    </changeSet>
    <changeSet id="1777312794693-26" author="gabig">
        <dropSequence sequenceName="token_seq"/>
    </changeSet>
    <changeSet id="1777312794693-27" author="gabig">
        <dropSequence sequenceName="user_seq"/>
    </changeSet>

</databaseChangeLog>